<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Example only: copy to ~/Library/LaunchAgents/, replace the placeholder paths, then
     launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/io.pkpipe.obsidian-vault.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>io.pkpipe.obsidian-vault</string>
  <key>ProgramArguments</key>
  <array>
    <string>/path/to/pkpipe/.venv/bin/python</string>
    <string>-m</string>
    <string>pkpipe.obsidian.server</string>
    <string>--config</string>
    <string>/path/to/vault-policy.json</string>
    <string>--host</string>
    <string>127.0.0.1</string>
    <string>--port</string>
    <string>8701</string>
  </array>
  <key>WorkingDirectory</key><string>/path/to/pkpipe</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/tmp/pkpipe-obsidian-vault.log</string>
  <key>StandardErrorPath</key><string>/tmp/pkpipe-obsidian-vault.err</string>
</dict>
</plist>
