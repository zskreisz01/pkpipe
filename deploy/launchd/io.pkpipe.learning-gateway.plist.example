<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Example only: copy to ~/Library/LaunchAgents/, replace the placeholder paths, then
     launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/io.pkpipe.learning-gateway.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>io.pkpipe.learning-gateway</string>
  <key>ProgramArguments</key>
  <array>
    <string>/path/to/pkpipe/.venv/bin/python</string>
    <string>-m</string>
    <string>pkpipe.learning.server</string>
    <string>--overlay</string>
    <string>/path/to/your/overlay</string>
    <string>--host</string>
    <string>127.0.0.1</string>
    <string>--port</string>
    <string>8703</string>
  </array>
  <key>WorkingDirectory</key><string>/path/to/pkpipe</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/tmp/pkpipe-learning-gateway.log</string>
  <key>StandardErrorPath</key><string>/tmp/pkpipe-learning-gateway.err</string>
</dict>
</plist>
