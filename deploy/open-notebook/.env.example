# Copy to .env (git-ignored) and fill in. Nothing here leaves your machine.
# Encrypts the API keys stored in Open Notebook:  openssl rand -hex 32
OPEN_NOTEBOOK_ENCRYPTION_KEY=
# SurrealDB root user for the local database (pick your own; the port is bound to 127.0.0.1)
SURREAL_USER=
SURREAL_PASSWORD=
