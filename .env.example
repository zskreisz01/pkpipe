# Model server (any OpenAI-compatible endpoint)
PKPIPE_MODEL_BASE_URL=http://127.0.0.1:1234/v1
PKPIPE_MODEL_NAME=qwen3.5-9b
# Private overlay with your own categories, instructions, contexts
PKPIPE_OVERLAY_DIR=../pkpipe-priv/overlay
PKPIPE_VAULT_DIR=/path/to/your/obsidian/vault
# Notifications (referenced from channels.json as env:...)
DISCORD_WEBHOOK_URL=
# OTLP/HTTP endpoint of the trace backend (Phoenix from deploy/docker-compose.yml)
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:6006
