<mxfile host="pkpipe"><diagram id="ctx" name="C4 - System context"><mxGraphModel grid="0" page="0" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ctx-t" value="pkpipe – system context: the system only sees the outside world through protocols" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="6" width="1300" height="36" as="geometry"/></mxCell><mxCell id="ctx-owner" value="&lt;b&gt;Owner&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Person]&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;captures, confirms triage, learns&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#08427b;strokeColor=#073b6f;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="60" width="300" height="110" as="geometry"/></mxCell><mxCell id="ctx-sys" value="&lt;b&gt;pkpipe&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Software system]&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;triage, guarded LLM sessions, curated notes, scheduling&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#1168bd;strokeColor=#0b4884;fontColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="520" y="330" width="380" height="160" as="geometry"/></mxCell><mxCell id="ctx-vault" value="&lt;b&gt;Obsidian vault&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[External system]&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;INBOX, triage file, journal, PARA folders&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#999999;strokeColor=#8a8a8a;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="320" height="120" as="geometry"/></mxCell><mxCell id="ctx-agent" value="&lt;b&gt;Chat agent&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[External system]&lt;/spa