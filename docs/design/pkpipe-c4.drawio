&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#999999;strokeColor=#8a8a8a;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1060" y="560" width="320" height="120" as="geometry"/></mxCell><mxCell id="ctx-web" value="&lt;b&gt;Web&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[External system]&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;search providers, web pages&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#999999;strokeColor=#8a8a8a;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="720" width="320" height="120" as="geometry"/></mxCell><mxCell id="ctx-learn" value="&lt;b&gt;Learning service&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[External system]&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;NotebookLM (nlm CLI); Open Notebook is deprecated&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#999999;strokeColor=#8a8a8a;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="740" y="720" width="320" height="120" as="geometry"/></mxCell><mxCell id="ctx-e11" value="captures, confirms" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontSize=11;fontColor=#444444;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ctx-owner" target="ctx-vault"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ctx-e12" value="configures, triages (HTTP UI)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontSize=11;fontColor=#444444;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ctx-owner" target="ctx-sys"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id=