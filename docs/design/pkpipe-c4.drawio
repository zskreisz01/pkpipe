#x27;&gt;evals.gate.PublishGate · evals.runner.EvalRunner · evals.ab&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#c6dcf2;strokeColor=#78a8d8;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="338" y="1140" width="300" height="120" as="geometry"/></mxCell><mxCell id="cmp-tel" value="&lt;b&gt;Telemetry&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Component]&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;OpenInference + FastAPI/httpx instrumentation, scrubbing&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;font-family:monospace&#x27;&gt;telemetry.runtime.Telemetry · telemetry.export&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#c6dcf2;strokeColor=#78a8d8;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="656" y="1140" width="300" height="120" as="geometry"/></mxCell><mxCell id="cmp-owner" value="&lt;b&gt;Owner vault channel&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Component]&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;triage decisions written in-process, same locking&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;font-family:monospace&#x27;&gt;pkpipe.obsidian.Vault (library)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#c6dcf2;strokeColor=#78a8d8;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="974" y="1140" width="300" height="120" as="geometry"/></mxCell><mxCell id="cmp-store" value="&lt;b&gt;App store&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Component]&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;drafts, publishes, owner audit log, item event log&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;font-family:monospace&#x27;&gt;adapters.app_store_sqlite.AppStore&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#c6dcf2;strokeColor=#78a8d8;font