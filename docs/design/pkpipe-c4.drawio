ell><mxCell id="ctx-e18" value="completions (OpenAI API)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontSize=11;fontColor=#444444;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ctx-sys" target="ctx-model"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ctx-e19" value="traces, metrics (OTLP)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontSize=11;fontColor=#444444;labelBackgroundColor=#ffffff;exitX=1;exitY=0.85;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ctx-sys" target="ctx-obs"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ctx-e20" value="search, fetch (HTTPS)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontSize=11;fontColor=#444444;labelBackgroundColor=#ffffff;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ctx-sys" target="ctx-web"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ctx-e21" value="notebook, podcast (REST / browser)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontSize=11;fontColor=#444444;labelBackgroundColor=#ffffff;exitX=0.7;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ctx-sys" target="ctx-learn"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="con" name="C4 - Containers"><mxGraphModel grid="0" page="0" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="con-t" value="pkpipe – containers: every box is a separate process; the app talks MCP, REST, OpenAI API and OTLP only" style="text;html=1;align=left;verticalAlign=middle;fontSize=1