ospace;font-size:10px&#x27;&gt;type · Config (pydantic)&lt;br&gt;run(ctx: StepContext) -&amp;gt; StepResult&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#438dd5;fontColor=#000000;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="800" y="90" width="330" height="64" as="geometry"/></mxCell><mxCell id="code-subs" value="&lt;b&gt;StepExecutor subclasses (pkpipe.steps)&lt;/b&gt;&lt;hr style=&#x27;margin:2px 0&#x27;&gt;&lt;span style=&#x27;font-family:monospace;font-size:10px&#x27;&gt;llm           llm.LlmStep&lt;br&gt;llm_tools     llm.LlmToolsStep&lt;br&gt;tool          tool.ToolStep&lt;br&gt;code          flow_control.CodeStep&lt;br&gt;notify        flow_control.NotifyStep&lt;br&gt;wait          flow_control.WaitStep&lt;br&gt;subflow       flow_control.SubflowStep&lt;br&gt;guard         flow_control.GuardStep&lt;br&gt;fetch         secure_fetch.FetchStep&lt;br&gt;sanitize      secure_fetch.SanitizeStep&lt;br&gt;reader        secure_fetch.ReaderStep&lt;br&gt;output_guard  output_guard.OutputGuardStep&lt;br&gt;session_plan  session_plan.SessionPlanStep&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#438dd5;fontColor=#000000;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="800" y="230" width="330" height="229" as="geometry"/></mxCell><mxCell id="code-codefn" value="&lt;b&gt;code functions (@register_code)&lt;/b&gt;&lt;hr style=&#x27;margin:2px 0&#x27;&gt;&lt;span style=&#x27;font-family:monospace;font-size:10px&#x27;&gt;steps.triage_code · steps.context_code&lt;br&gt;steps.improvement_code · steps.learning_code&lt;br&gt;steps.security_code · steps.secure_fetch&lt;br&gt;steps.session_plan (category.*)&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#438dd5;fontColor=#000000;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex=