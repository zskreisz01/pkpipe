><mxPoint x="1600" y="1250"/></Array></mxGeometry></mxCell><mxCell id="con-note" value="&lt;b&gt;Owner channel&lt;/b&gt;: the UI and app MCP read the triage file and write owner decisions through the &lt;code&gt;pkpipe.obsidian&lt;/code&gt; library in-process (same locking), never through a tool LLM sessions can reach.&lt;br&gt;&lt;br&gt;&lt;b&gt;Egress&lt;/b&gt;: only web-search, web-fetch and learning-gateway reach the network; raw page text only reaches sessions without tools." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1580" y="280" width="280" height="260" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="cmp" name="C4 - Components"><mxGraphModel grid="0" page="0" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="cmp-t" value="pkpipe app – components: the core only knows ports; adapters are replaceable" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="6" width="1900" height="36" as="geometry"/></mxCell><mxCell id="cmp-h20" value="&lt;b&gt;Inbound adapters&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="700" height="24" as="geometry"/></mxCell><mxCell id="cmp-h320" value="&lt;b&gt;Application core (pkpipe.engine, .domain, .steps, .security)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="320" y="50" width="700" height="24" as="geometry"/></mxCell><mxCell id="cmp-h1060" value="&lt;b&gt;Ports (pkpipe.ports)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1060" y="50" width="700" height="24" as="geometry"/></mxCell><mxCell id="cmp-h1350" value="&lt;b&gt;Out