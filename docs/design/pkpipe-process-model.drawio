<diagram id="pkh" name="Handle Security Flag"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="640" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" />
<mxCell id="pkh-title" value="&lt;b style=&quot;font-size:15px&quot;&gt;Handle Security Flag (called per flagged item)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#555&quot;&gt;Stops the item, logs the malicious URL, quarantines the content in inert form and alerts · false positives are released by the owner on the daily page&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="6" width="1110" height="36" as="geometry" /></mxCell>
