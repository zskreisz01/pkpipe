{
  "obsidian": {
    "transport": "streamable_http",
    "url": "http://127.0.0.1:8701/mcp",
    "allow": [
      "read_note",
      "write_note",
      "move_note",
      "list_folder",
      "read_triage",
      "update_triage",
      "upsert_processing_list",
      "read_notes",
      "read_improvements",
      "update_improvements",
      "read_tool_candidates",
      "update_tool_candidates",
      "quarantine_note",
      "inbox_remove_entries",
      "read_processing_list",
      "read_in_progress",
      "inbox_in_progress",
      "write_results_index",
      "import_audio",
      "read_image",
      "unreviewed_notes",
      "failed_items",
      "write_journal_todos"
    ]
  },
  "websearch": {
    "transport": "streamable_http",
    "url": "http://127.0.0.1:8702/mcp",
    "allow": [
      "search"
    ],
    "egress": true
  },
  "webfetch": {
    "transport": "streamable_http",
    "url": "http://127.0.0.1:8704/mcp",
    "allow": [
      "fetch_page"
    ],
    "egress": true
  },
  "learning": {
    "transport": "streamable_http",
    "url": "http://127.0.0.1:8703/mcp",
    "backend": "notebooklm_browser",
    "allow": [
      "create",
      "status",
      "link",
      "audio"
    ],
    "egress": true,
    "options": {
      "timeout_s": 5400
    }
  }
}
