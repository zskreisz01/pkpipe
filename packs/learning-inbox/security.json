{
  "classifier": {
    "backend": "combined",
    "threshold": 0.5,
    "required": true,
    "members": [
      {
        "backend": "qwen3guard",
        "model": "Qwen/Qwen3Guard-Gen-0.6B",
        "chunk_tokens": 1024
      },
      {
        "backend": "deberta",
        "model": "protectai/deberta-v3-base-prompt-injection-v2",
        "chunk_tokens": 512
      }
    ]
  },
  "output_guard": {
    "block_on": [
      "Unsafe"
    ]
  },
  "canary": {
    "rotate": "per_run"
  },
  "url_filter": {
    "block_private_networks": true,
    "max_bytes": 2000000,
    "deny_list": "security/deny_list.txt"
  },
  "query_guard": {
    "terms_file": "security/query_guard_terms.txt"
  }
}
