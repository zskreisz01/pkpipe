{
  "id": "learning_material",
  "description": "URL check, then a notebook from the URL and the prompt template only, wait for the generation result (poll + deadline above the gateway timeout), fetch audio and link, update the list. A URL the gateway refuses (DNS, deny list) goes to handle_security_flag (log, deny-list, quarantine, alert); any other create error leaves the item released for the next run. No session runs and no derived text is written to the vault (only notebook id, link and audio path), so there is no output to guard.",
  "bpmn": "process-learning-material",
  "start": "read",
  "nodes": [
    {
      "id": "read",
      "type": "tool",
      "bpmn_element": "URL check",
      "config": {
        "tool": "obsidian:read_note",
        "arguments": {
          "path": "${item.path}"
        }
      }
    },
    {
      "id": "prepare",
      "type": "code",
      "bpmn_element": "URL check",
      "config": {
        "function": "learning.prepare",
        "args": {
          "note": "${read}",
          "instruction": "learning-material/notebook.md"
        }
      }
    },
    {
      "id": "security_flag",
      "type": "subflow",
      "bpmn_element": "Handle security flag",
      "config": {
        "flow": "handle_security_flag"
      }
    },
    {
      "id": "no_url",
      "type": "code",
      "bpmn_element": "Update list: status failed",
      "config": {
        "function": "item.set",
        "args": {
          "processing_status": "failed",
          "failure_reason": "no source URL in the note"
        }
      }
    },
    {
      "id": "create",
      "type": "tool",
      "bpmn_element": "Create notebook + source",
      "config": {
        "tool": "learning:create",
        "arguments": {
          "url": "${prepare.url}",
          "template": "${prepare.template}",
          "item_id": "${item.id}"
        }
      }
    },
    {
      "id": "create_failed",
      "type": "code",
      "bpmn_element": "URL check",
      "config": {
        "function": "learning.create_failed",
        "args": {
          "error": "${error}"
        }
      }
    },
    {
      "id": "wait_generation",
      "type": "wait",
      "bpmn_element": "Wait for generation result",
      "config": {
        "tool": "learning:status",
        "arguments": {
          "job_id": "${create.job_id}"
        },
        "until": {
          "path": "result.status",
          "in": [
            "ready",
            "failed"
          ]
        },
        "poll_s": 60,
        "deadline_s": 6000
      }
    },
    {
      "id": "link",
      "type": "tool",
      "bpmn_element": "Get audio + link",
      "config": {
        "tool": "learning:link",
        "arguments": {
          "nb_id": "${create.nb_id}"
        }
      }
    },
    {
      "id": "audio",
      "type": "tool",
      "bpmn_element": "Get audio + link",
      "config": {
        "tool": "learning:audio",
        "arguments": {
          "job_id": "${create.job_id}"
        }
      }
    },
    {
      "id": "ready",
      "type": "code",
      "bpmn_element": "Update list: status ready",
      "config": {
        "function": "item.set",
        "args": {
          "nb_id": "${create.nb_id}",
          "link": "${link.url}",
          "audio_path": "${audio.audio_path}",
          "processing_status": "ready"
        }
      }
    },
    {
      "id": "failed",
      "type": "code",
      "bpmn_element": "Update list: status failed",
      "config": {
        "function": "item.set",
        "args": {
          "nb_id": "${create.nb_id}",
          "processing_status": "failed",
          "failure_reason": "${wait_generation.reason}"
        }
      }
    },
    {
      "id": "timeout",
      "type": "code",
      "bpmn_element": "Update list: status failed",
      "config": {
        "function": "item.set",
        "args": {
          "nb_id": "${create.nb_id}",
          "processing_status": "failed",
          "failure_reason": "${error.message}"
        }
      }
    },
    {
      "id": "audio_failed",
      "type": "code",
      "bpmn_element": "Update list: status failed",
      "config": {
        "function": "item.set",
        "args": {
          "nb_id": "${create.nb_id}",
          "link": "${link.url}",
          "processing_status": "failed",
          "failure_reason": "audio could not be fetched"
        }
      }
    }
  ],
  "edges": [
    {
      "from": "read",
      "to": "prepare"
    },
    {
      "from": "prepare",
      "to": "security_flag",
      "when": {
        "path": "prepare.status",
        "eq": "blocked"
      }
    },
    {
      "from": "prepare",
      "to": "no_url",
      "when": {
        "path": "prepare.status",
        "eq": "no_url"
      }
    },
    {
      "from": "prepare",
      "to": "create",
      "default": true
    },
    {
      "from": "create",
      "to": "wait_generation"
    },
    {
      "from": "create",
      "to": "create_failed",
      "on": "error"
    },
    {
      "from": "create_failed",
      "to": "security_flag"
    },
    {
      "from": "wait_generation",
      "to": "link",
      "when": {
        "path": "wait_generation.status",
        "eq": "ready"
      }
    },
    {
      "from": "wait_generation",
      "to": "failed",
      "default": true
    },
    {
      "from": "wait_generation",
      "to": "timeout",
      "on": "error"
    },
    {
      "from": "link",
      "to": "audio"
    },
    {
      "from": "audio",
      "to": "ready"
    },
    {
      "from": "audio",
      "to": "audio_failed",
      "on": "error"
    }
  ]
}
