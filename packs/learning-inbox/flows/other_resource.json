{
  "id": "other_resource",
  "description": "Summarize the item in an isolated session without tools, pass the output guard, write the note into its PARA folder or quarantine the item. Spec 010 replaces the single session with the category's session plan.",
  "bpmn": "process-other-resource",
  "start": "read",
  "nodes": [
    {
      "id": "read",
      "type": "tool",
      "bpmn_element": "Read item",
      "config": {
        "tool": "obsidian:read_note",
        "arguments": {
          "path": "${item.path}"
        }
      }
    },
    {
      "id": "summarize",
      "type": "llm",
      "bpmn_element": "Run category sessions",
      "inputs": [
        "item.category",
        "read.body"
      ],
      "config": {
        "system": "synthesizer",
        "instruction": "other/summarize.md",
        "output_schema": "resource_note"
      }
    },
    {
      "id": "guard",
      "type": "guard",
      "bpmn_element": "Output guard",
      "config": {
        "input": "summarize.note",
        "patterns": [
          "\\b(ignore|disregard|forget|override|bypass)\\b[^.\\n]{0,40}\\b(instructions?|prompts?|rules|guidelines|polic(y|ies)|told)\\b",
          "\\b(new|updated)\\s+(system\\s+)?instructions?\\s*:|\\bsystem\\s*(override\\b|:)|^\\s*#+\\s*system\\b",
          "<\\|im_(start|end)\\|>|\\[/?INST\\]|<<\\s*SYS\\s*>>",
          "\\byou\\s+are\\s+now\\b|\\b(enable|enter|activate)\\s+developer\\s+mode\\b|\\b(no|without)\\s+(restrictions|limits|guidelines|content\\s+policy|rules)\\b",
          "display\\s*:\\s*none|visibility\\s*:\\s*hidden|font-size\\s*:\\s*0|<\\w+[^>]*\\shidden[\\s>]|color\\s*:\\s*white\\s*;\\s*background(-color)?\\s*:\\s*white|<!--[^>]*\\b(ai|assistant|model|llm)s?\\b",
          "<\\s*script|javascript\\s*:|\\bon(error|load|click|mouseover)\\s*=|<\\s*iframe",
          "\\b(repeat|print|reveal|show|output|tell me|what is)\\b[^.\\n]{0,40}\\b(system\\s+prompt|hidden\\s+instructions|reference\\s+code|secret|token|canary|confidential)|\\b(text|everything)\\s+above\\b",
          "!\\[[^\\]]*\\]\\(https?://|\\b(send|post|upload|exfiltrate)\\b[^.\\n]{0,60}\\b(journal|notes|context|api\\s+keys?|passwords?)\\b|\\bapi[_\\s-]?keys?\\b"
        ]
      }
    },
    {
      "id": "quarantine",
      "type": "code",
      "bpmn_element": "Handle security flag",
      "config": {
        "function": "item.set",
        "args": {
          "state": "quarantined"
        }
      }
    },
    {
      "id": "write",
      "type": "tool",
      "bpmn_element": "Write note",
      "config": {
        "tool": "obsidian:write_note",
        "arguments": {
          "path": "${item.para_path}/${item.id}.md",
          "body": "# ${summarize.title}\n\n${summarize.note}\n",
          "front_matter": {
            "source": "${item.resource}",
            "category": "${item.category}",
            "pkpipe_item": "${item.id}"
          },
          "overwrite": true
        }
      }
    },
    {
      "id": "record",
      "type": "code",
      "bpmn_element": "Write note",
      "config": {
        "function": "item.set",
        "args": {
          "note": "${item.para_path}/${item.id}.md",
          "processing_status": "done"
        }
      }
    }
  ],
  "edges": [
    {
      "from": "read",
      "to": "summarize"
    },
    {
      "from": "summarize",
      "to": "guard"
    },
    {
      "from": "guard",
      "to": "quarantine",
      "when": {
        "path": "guard.flagged",
        "truthy": true
      }
    },
    {
      "from": "guard",
      "to": "write",
      "default": true
    },
    {
      "from": "write",
      "to": "record"
    }
  ]
}
