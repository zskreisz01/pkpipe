{
  "id": "other_resource",
  "description": "Process one released item of a category with a session plan (Tool, Marketing, Misc, overlay categories): load the plan from categories.json, run secure fetch when a session reads the page extract (raw page text only reaches the Reader), run the sessions in plan order (spec 010; each is an isolated session with its declared inputs, the run canary and its own span), check everything they produced with the output guard, then store the note in the category's PARA folder (with its system relevance, spec 016), add a new-category suggestion to the agent tasks, add a system tool candidate to System-Tool-Candidates (a rejected or adopted tool is never added again), set the processing-list status and archive the INBOX note. A flag hands the item to handle_security_flag; a classifier warning of the injection detector alone is held for the owner (hold_review, spec 029) instead of being quarantined; a failed session or fetch lists the item as failed with the reason. Spec 025: an image item first loads its cached description (subflow load_image_description); an item without a URL in a category with source_discovery is not failed: item.find_sources searches the web with a guarded query built from the validated description or text, the found pages go through secure fetch one after the other (the next one when a fetch fails) and the category's own sessions evaluate the first clean page.",
  "bpmn": "process-other-resource",
  "nodes": [
    {
      "id": "load_description",
      "type": "subflow",
      "bpmn_element": "Load image description from the cache (image items; no model call)",
      "config": {
        "flow": "load_image_description"
      }
    },
    {
      "id": "fetch_note",
      "type": "tool",
      "bpmn_element": "Process other resource",
      "config": {
        "tool": "obsidian:read_note",
        "arguments": {
          "path": "${item.path}"
        }
      }
    },
    {
      "id": "read",
      "type": "code",
      "bpmn_element": "Process other resource",
      "config": {
        "function": "inbox.source_note"
      }
    },
    {
      "id": "plan",
      "type": "code",
      "bpmn_element": "Load category session plan (sessions, instructions, context)",
      "config": {
        "function": "category.plan",
        "args": {
          "note": "${read}"
        }
      }
    },
    {
      "id": "no_plan",
      "type": "code",
      "bpmn_element": "List item as failed (reason in the processing list)",
      "config": {
        "function": "item.set",
        "args": {
          "processing_status": "failed",
          "failure_reason": "the category has no session plan"
        }
      }
    },
    {
      "id": "no_url",
      "type": "code",
      "bpmn_element": "List item as failed (reason in the processing list)",
      "config": {
        "function": "item.set",
        "args": {
          "processing_status": "failed",
          "failure_reason": "no source URL in the note"
        }
      }
    },
    {
      "id": "discover",
      "type": "code",
      "bpmn_element": "Find source by web search (guarded query, next page if a fetch fails)",
      "config": {
        "function": "item.find_sources",
        "args": {
          "note": "${read}"
        }
      }
    },
    {
      "id": "no_source",
      "type": "code",
      "bpmn_element": "List item as failed (reason in the processing list)",
      "config": {
        "function": "item.set",
        "args": {
          "processing_status": "failed",
          "failure_reason": "${discover.reason}"
        }
      }
    },
    {
      "id": "next_source",
      "type": "code",
      "bpmn_element": "Find source by web search (guarded query, next page if a fetch fails)",
      "config": {
        "function": "item.next_source"
      }
    },
    {
      "id": "secure_fetch",
      "type": "subflow",
      "bpmn_element": "Secure fetch",
      "config": {
        "flow": "secure_fetch"
      }
    },
    {
      "id": "hold_review",
      "type": "code",
      "bpmn_element": "Hold for the owner (classifier warning only)",
      "config": {
        "function": "security.hold_for_review"
      }
    },
    {
      "id": "fetch_failed",
      "type": "code",
      "bpmn_element": "List item as failed (reason in the processing list)",
      "config": {
        "function": "item.set",
        "args": {
          "processing_status": "failed",
          "failure_reason": "the page could not be fetched"
        }
      }
    },
    {
      "id": "run_sessions",
      "type": "session_plan",
      "bpmn_element": "Run category sessions",
      "config": {
        "category": "${item.category}",
        "note_text": "${read.body}"
      }
    },
    {
      "id": "session_failed",
      "type": "code",
      "bpmn_element": "List item as failed (reason in the processing list)",
      "config": {
        "function": "category.session_failed",
        "args": {
          "error": "${error}"
        }
      }
    },
    {
      "id": "guard",
      "type": "output_guard",
      "bpmn_element": "Output guard (canary, heuristics, Qwen3Guard + DeBERTa)",
      "config": {
        "input": [
          "run_sessions"
        ]
      }
    },
    {
      "id": "security_flag",
      "type": "subflow",
      "bpmn_element": "Security flag",
      "config": {
        "flow": "handle_security_flag"
      }
    },
    {
      "id": "candidates",
      "type": "tool",
      "bpmn_element": "Add system tool candidate (code decides)",
      "config": {
        "tool": "obsidian:read_tool_candidates",
        "arguments": {}
      }
    },
    {
      "id": "note",
      "type": "code",
      "bpmn_element": "Store in Obsidian (PARA location by category)",
      "config": {
        "function": "category.note",
        "args": {
          "sessions": "${run_sessions}",
          "candidates": "${candidates}"
        }
      }
    },
    {
      "id": "write",
      "type": "tool",
      "bpmn_element": "Store in Obsidian (PARA location by category)",
      "config": {
        "tool": "obsidian:write_note",
        "arguments": {
          "path": "${note.path}",
          "body": "${note.body}",
          "front_matter": "${note.front_matter}",
          "overwrite": true
        }
      }
    },
    {
      "id": "agent_task",
      "type": "tool",
      "bpmn_element": "Add new-category suggestion to agent tasks",
      "config": {
        "tool": "obsidian:write_note",
        "arguments": {
          "path": "${note.task_path}",
          "body": "${note.task_body}",
          "front_matter": "${note.task_front_matter}",
          "overwrite": true
        }
      }
    },
    {
      "id": "candidate_write",
      "type": "tool",
      "bpmn_element": "Add system tool candidate (code decides)",
      "config": {
        "tool": "obsidian:update_tool_candidates",
        "arguments": {
          "rows": "${note.candidate_rows}"
        }
      }
    },
    {
      "id": "record",
      "type": "code",
      "bpmn_element": "Add to processing list (status = unprocessed)",
      "config": {
        "function": "item.set",
        "args": {
          "note": "${note.path}",
          "processing_status": "done"
        }
      }
    },
    {
      "id": "archive",
      "type": "tool",
      "bpmn_element": "Archive item in INBOX",
      "config": {
        "tool": "obsidian:move_note",
        "arguments": {
          "src": "${item.path}",
          "dst": "${note.archive_path}"
        }
      }
    },
    {
      "id": "archive_failed",
      "type": "code",
      "bpmn_element": "Archive item in INBOX",
      "config": {
        "function": "item.set",
        "args": {
          "archived": false
        }
      }
    }
  ],
  "edges": [
    {
      "from": "START",
      "to": "load_description",
      "when": {
        "path": "item.kind",
        "eq": "image"
      }
    },
    {
      "from": "START",
      "to": "fetch_note",
      "when": {
        "path": "item.path",
        "exists": true
      }
    },
    {
      "from": "START",
      "to": "read",
      "default": true
    },
    {
      "from": "load_description",
      "to": "security_flag",
      "when": {
        "path": "item.flagged",
        "truthy": true
      }
    },
    {
      "from": "load_description",
      "to": "read",
      "default": true
    },
    {
      "from": "fetch_note",
      "to": "read"
    },
    {
      "from": "read",
      "to": "plan"
    },
    {
      "from": "plan",
      "to": "no_plan",
      "when": {
        "path": "plan.status",
        "eq": "no_plan"
      }
    },
    {
      "from": "plan",
      "to": "no_url",
      "when": {
        "path": "plan.status",
        "eq": "no_url"
      }
    },
    {
      "from": "plan",
      "to": "discover",
      "when": {
        "path": "plan.status",
        "eq": "discover"
      }
    },
    {
      "from": "plan",
      "to": "secure_fetch",
      "when": {
        "path": "plan.needs_fetch",
        "truthy": true
      }
    },
    {
      "from": "plan",
      "to": "run_sessions",
      "default": true
    },
    {
      "from": "secure_fetch",
      "to": "security_flag",
      "when": {
        "path": "item.flagged",
        "truthy": true
      }
    },
    {
      "from": "secure_fetch",
      "to": "run_sessions",
      "when": {
        "path": "item.fetch_status",
        "eq": "clean"
      }
    },
    {
      "from": "secure_fetch",
      "to": "hold_review",
      "when": {
        "path": "item.fetch_status",
        "eq": "review"
      }
    },
    {
      "from": "secure_fetch",
      "to": "next_source",
      "when": {
        "path": "item.source_discovered",
        "truthy": true
      }
    },
    {
      "from": "secure_fetch",
      "to": "fetch_failed",
      "default": true
    },
    {
      "from": "discover",
      "to": "secure_fetch",
      "when": {
        "path": "discover.status",
        "eq": "ok"
      }
    },
    {
      "from": "discover",
      "to": "no_source",
      "default": true
    },
    {
      "from": "next_source",
      "to": "secure_fetch",
      "when": {
        "path": "next_source.status",
        "eq": "ok"
      }
    },
    {
      "from": "next_source",
      "to": "fetch_failed",
      "default": true
    },
    {
      "from": "run_sessions",
      "to": "guard"
    },
    {
      "from": "run_sessions",
      "to": "session_failed",
      "on": "error"
    },
    {
      "from": "guard",
      "to": "security_flag",
      "when": {
        "path": "guard.flagged",
        "truthy": true
      }
    },
    {
      "from": "guard",
      "to": "candidates",
      "default": true
    },
    {
      "from": "candidates",
      "to": "note"
    },
    {
      "from": "note",
      "to": "write"
    },
    {
      "from": "write",
      "to": "agent_task",
      "when": {
        "path": "note.has_task",
        "truthy": true
      }
    },
    {
      "from": "write",
      "to": "candidate_write",
      "when": {
        "path": "note.has_candidate",
        "truthy": true
      }
    },
    {
      "from": "write",
      "to": "record",
      "default": true
    },
    {
      "from": "agent_task",
      "to": "candidate_write",
      "when": {
        "path": "note.has_candidate",
        "truthy": true
      }
    },
    {
      "from": "agent_task",
      "to": "record",
      "default": true
    },
    {
      "from": "candidate_write",
      "to": "record"
    },
    {
      "from": "record",
      "to": "archive",
      "when": {
        "path": "item.path",
        "exists": true
      }
    },
    {
      "from": "record",
      "to": "END",
      "default": true
    },
    {
      "from": "archive",
      "to": "archive_failed",
      "on": "error"
    }
  ]
}
