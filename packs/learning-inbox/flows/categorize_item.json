{
  "id": "categorize_item",
  "description": "One INBOX item: read it (code), suggest a category (isolated session, no tools, datamarked input, run canary), check the suggestion with the output guard, accept only a configured category (code). A flagged suggestion is never written: the item goes to handle_security_flag (quarantine).",
  "bpmn": "process-inbox-items",
  "start": "read",
  "nodes": [
    {
      "id": "read",
      "type": "tool",
      "bpmn_element": "Read new INBOX items",
      "config": {
        "tool": "obsidian:read_note",
        "arguments": {
          "path": "${item.path}"
        }
      }
    },
    {
      "id": "menu",
      "type": "code",
      "bpmn_element": "Categorize each item",
      "config": {
        "function": "triage.category_menu"
      }
    },
    {
      "id": "suggest",
      "type": "llm",
      "bpmn_element": "Categorize each item",
      "inputs": [
        "menu.categories",
        "item.resource",
        "read.front_matter",
        "read.body"
      ],
      "config": {
        "system": "triage",
        "instruction": "triage/categorize.md",
        "output_schema": "triage_result",
        "canary": true
      }
    },
    {
      "id": "guard",
      "type": "output_guard",
      "bpmn_element": "Output guard",
      "config": {
        "input": [
          "suggest"
        ]
      }
    },
    {
      "id": "security_flag",
      "type": "subflow",
      "bpmn_element": "Handle security flag",
      "config": {
        "flow": "handle_security_flag"
      }
    },
    {
      "id": "check",
      "type": "code",
      "bpmn_element": "Categorize each item",
      "config": {
        "function": "triage.check_category",
        "args": {
          "suggestion": "${suggest}"
        }
      }
    }
  ],
  "edges": [
    {
      "from": "read",
      "to": "menu"
    },
    {
      "from": "menu",
      "to": "suggest"
    },
    {
      "from": "suggest",
      "to": "guard"
    },
    {
      "from": "guard",
      "to": "security_flag",
      "when": {
        "path": "guard.flagged",
        "truthy": true
      }
    },
    {
      "from": "guard",
      "to": "check",
      "default": true
    }
  ]
}
