{
  "id": "process_released",
  "description": "06:00: release confirmed or overridden items, process each released item in its own instance (parallel, limited), write states and the processing list, remove the entries of processed list items from the INBOX list file (spec 020), keep the table of unfinished items (spec 031: INBOX-InProgress.md), send the run report (spec 024; the earlier one-line daily summary when report.enabled is false). Spec 032: after the INBOX-InProgress table, the `_Index.md` of every result folder is refreshed (subflow write_results_index; a failure never stops the report).",
  "bpmn": "process-inbox-items",
  "start": "read_triage",
  "max_parallel": 2,
  "nodes": [
    {
      "id": "read_triage",
      "type": "tool",
      "bpmn_element": "Select confirmed / overridden items",
      "config": {
        "tool": "obsidian:read_triage"
      }
    },
    {
      "id": "release",
      "type": "code",
      "bpmn_element": "Select confirmed / overridden items",
      "config": {
        "function": "triage.release",
        "args": {
          "triage": "${read_triage}"
        }
      }
    },
    {
      "id": "mark_states",
      "type": "tool",
      "bpmn_element": "Select confirmed / overridden items",
      "config": {
        "tool": "obsidian:update_triage",
        "arguments": {
          "rows": "${release.rows}"
        }
      }
    },
    {
      "id": "process_item",
      "type": "subflow",
      "bpmn_element": "Process each released item",
      "for_each": "release.released",
      "on_item_error": "continue",
      "config": {
        "flow": "process_item"
      }
    },
    {
      "id": "propose",
      "type": "subflow",
      "bpmn_element": "Propose new category",
      "for_each": "release.proposals",
      "on_item_error": "continue",
      "config": {
        "flow": "propose_category"
      }
    },
    {
      "id": "finalize",
      "type": "code",
      "bpmn_element": "Process each released item",
      "config": {
        "function": "triage.finalize",
        "args": {
          "results": "${process_item}"
        }
      }
    },
    {
      "id": "write_states",
      "type": "tool",
      "bpmn_element": "Process each released item",
      "config": {
        "tool": "obsidian:update_triage",
        "arguments": {
          "rows": "${finalize.triage_rows}"
        }
      }
    },
    {
      "id": "write_processing",
      "type": "tool",
      "bpmn_element": "Process each released item",
      "config": {
        "tool": "obsidian:upsert_processing_list",
        "arguments": {
          "rows": "${finalize.processing_rows}"
        }
      }
    },
    {
      "id": "read_moved",
      "type": "tool",
      "bpmn_element": "Remove processed entry from the INBOX list",
      "config": {
        "tool": "obsidian:read_in_progress"
      }
    },
    {
      "id": "read_list",
      "type": "tool",
      "bpmn_element": "Remove processed entry from the INBOX list",
      "config": {
        "tool": "obsidian:read_note",
        "arguments": {
          "path": "${config.layout.inbox_list_file}"
        }
      }
    },
    {
      "id": "consume",
      "type": "code",
      "bpmn_element": "Remove processed entry from the INBOX list",
      "config": {
        "function": "inbox.consume",
        "args": {
          "list_note": "${read_list}",
          "ids": "${finalize.consume_ids}"
        }
      }
    },
    {
      "id": "remove_entries",
      "type": "tool",
      "bpmn_element": "Remove processed entry from the INBOX list",
      "config": {
        "tool": "obsidian:inbox_remove_entries",
        "arguments": {
          "entries": "${consume.entries}"
        }
      }
    },
    {
      "id": "list_report",
      "type": "code",
      "bpmn_element": "Remove processed entry from the INBOX list",
      "config": {
        "function": "inbox.report",
        "args": {}
      }
    },
    {
      "id": "in_progress",
      "type": "subflow",
      "bpmn_element": "Move unfinished entries to INBOX-InProgress",
      "config": {
        "flow": "inbox_in_progress"
      }
    },
    {
      "id": "results_index",
      "type": "subflow",
      "bpmn_element": "Refresh result indexes",
      "config": {
        "flow": "write_results_index"
      }
    },
    {
      "id": "report_cfg",
      "type": "code",
      "bpmn_element": "Send run report",
      "config": {
        "function": "report.settings",
        "args": {
          "kind": "process_released",
          "notify": true,
          "results": "${process_item}",
          "release": "${release}",
          "list_report": "${list_report}"
        }
      }
    },
    {
      "id": "summary",
      "type": "notify",
      "bpmn_element": "Send run report",
      "config": {
        "event": "daily_summary",
        "message": "Processed ${finalize.processed}, quarantined ${finalize.quarantined}, failed ${finalize.failed}; ${release.count_pending} item(s) still pending.${release.proposal_note}${list_report.note}",
        "payload": {
          "processed": "${finalize.processed}",
          "quarantined": "${finalize.quarantined}",
          "failed": "${finalize.failed}",
          "pending": "${release.count_pending}",
          "list_not_found": "${list_report.count_not_found}",
          "list_remove_failed": "${list_report.remove_failed}"
        }
      }
    },
    {
      "id": "run_report",
      "type": "subflow",
      "bpmn_element": "Send run report",
      "config": {
        "flow": "run_report",
        "item": "${report_cfg.item}"
      }
    }
  ],
  "edges": [
    {
      "from": "read_triage",
      "to": "release"
    },
    {
      "from": "release",
      "to": "mark_states",
      "when": {
        "path": "release.rows.0",
        "exists": true
      }
    },
    {
      "from": "release",
      "to": "process_item",
      "default": true
    },
    {
      "from": "mark_states",
      "to": "process_item"
    },
    {
      "from": "process_item",
      "to": "propose"
    },
    {
      "from": "propose",
      "to": "finalize"
    },
    {
      "from": "finalize",
      "to": "write_states",
      "when": {
        "path": "finalize.has_triage_rows",
        "truthy": true
      }
    },
    {
      "from": "finalize",
      "to": "list_report",
      "default": true
    },
    {
      "from": "write_states",
      "to": "write_processing",
      "when": {
        "path": "finalize.has_processing_rows",
        "truthy": true
      }
    },
    {
      "from": "write_states",
      "to": "list_report",
      "default": true
    },
    {
      "from": "write_processing",
      "to": "read_moved",
      "when": {
        "path": "finalize.consume_ids.0",
        "exists": true
      }
    },
    {
      "from": "read_moved",
      "to": "read_list"
    },
    {
      "from": "read_moved",
      "to": "read_list",
      "on": "error"
    },
    {
      "from": "write_processing",
      "to": "list_report",
      "default": true
    },
    {
      "from": "read_list",
      "to": "consume"
    },
    {
      "from": "consume",
      "to": "remove_entries",
      "when": {
        "path": "consume.entries.0",
        "exists": true
      }
    },
    {
      "from": "consume",
      "to": "list_report",
      "default": true
    },
    {
      "from": "remove_entries",
      "to": "list_report"
    },
    {
      "from": "remove_entries",
      "to": "list_report",
      "on": "error"
    },
    {
      "from": "list_report",
      "to": "in_progress"
    },
    {
      "from": "in_progress",
      "to": "results_index"
    },
    {
      "from": "in_progress",
      "to": "results_index",
      "on": "error"
    },
    {
      "from": "results_index",
      "to": "report_cfg"
    },
    {
      "from": "results_index",
      "to": "report_cfg",
      "on": "error"
    },
    {
      "from": "report_cfg",
      "to": "summary",
      "when": {
        "path": "report_cfg.legacy_notify",
        "truthy": true
      }
    },
    {
      "from": "report_cfg",
      "to": "run_report",
      "when": {
        "path": "report_cfg.enabled",
        "truthy": true
      }
    },
    {
      "from": "run_report",
      "to": "END",
      "on": "error"
    }
  ]
}
