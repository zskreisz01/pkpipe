{
  "id": "triage",
  "description": "20:00: bring the triage table up to date (maintenance call: columns, owner comment migration), read new INBOX items (one note per item, or the entries of the INBOX list file when the layout names one), suggest a category per text item in an isolated session without tools, write the triage file, then describe the new image entries with the local vision model (phase two, bounded by the time budget, spec 021) and write their rows, then send the run report (spec 024: new suggestions per category, what waits for the owner, todos with counts; the earlier triage_ready message when report.enabled is false).",
  "bpmn": "process-inbox-items",
  "start": "cycle",
  "max_parallel": 2,
  "nodes": [
    {
      "id": "cycle",
      "type": "code",
      "bpmn_element": "Read new INBOX items",
      "config": {
        "function": "triage.cycle_start"
      }
    },
    {
      "id": "migrate",
      "type": "tool",
      "bpmn_element": "Read new INBOX items",
      "config": {
        "tool": "obsidian:update_triage",
        "arguments": {
          "rows": []
        }
      }
    },
    {
      "id": "list_inbox",
      "type": "tool",
      "bpmn_element": "Read new INBOX items",
      "config": {
        "tool": "obsidian:list_folder",
        "arguments": {
          "path": "${config.layout.inbox_dir}"
        }
      }
    },
    {
      "id": "read_triage",
      "type": "tool",
      "bpmn_element": "Read new INBOX items",
      "config": {
        "tool": "obsidian:read_triage"
      }
    },
    {
      "id": "read_list",
      "type": "tool",
      "bpmn_element": "Parse INBOX list",
      "config": {
        "tool": "obsidian:read_note",
        "arguments": {
          "path": "${config.layout.inbox_list_file}"
        }
      }
    },
    {
      "id": "parse_list",
      "type": "code",
      "bpmn_element": "Parse INBOX list",
      "config": {
        "function": "inbox.parse_list",
        "args": {
          "note": "${read_list}"
        }
      }
    },
    {
      "id": "select_new",
      "type": "code",
      "bpmn_element": "Read new INBOX items",
      "config": {
        "function": "inbox.select_new",
        "args": {
          "listing": "${list_inbox}",
          "triage": "${read_triage}",
          "folder": "${config.layout.inbox_dir}"
        }
      }
    },
    {
      "id": "categorize",
      "type": "subflow",
      "bpmn_element": "Categorize each item",
      "for_each": "select_new.items",
      "on_item_error": "continue",
      "config": {
        "flow": "categorize_item"
      }
    },
    {
      "id": "rows",
      "type": "code",
      "bpmn_element": "Categorize each item",
      "config": {
        "function": "triage.suggested_rows",
        "args": {
          "results": "${categorize}",
          "owner_items": "${select_new.owner_items}"
        }
      }
    },
    {
      "id": "write_triage",
      "type": "tool",
      "bpmn_element": "Categorize each item",
      "config": {
        "tool": "obsidian:update_triage",
        "arguments": {
          "rows": "${rows.rows}"
        }
      }
    },
    {
      "id": "img_handoff",
      "type": "code",
      "bpmn_element": "Describe images",
      "config": {
        "function": "image.handoff",
        "args": {
          "images": "${select_new.image_items}",
          "cycle_started": "${cycle.started}"
        }
      }
    },
    {
      "id": "images",
      "type": "subflow",
      "bpmn_element": "Describe images",
      "config": {
        "flow": "describe_images",
        "item": "${img_handoff.item}"
      }
    },
    {
      "id": "write_image_rows",
      "type": "tool",
      "bpmn_element": "Describe images",
      "config": {
        "tool": "obsidian:update_triage",
        "arguments": {
          "rows": "${images.outputs.finish.rows}"
        }
      }
    },
    {
      "id": "backlog",
      "type": "code",
      "bpmn_element": "Send run report",
      "config": {
        "function": "triage.backlog",
        "args": {
          "triage": "${read_triage}",
          "new_rows": "${rows.rows}"
        }
      }
    },
    {
      "id": "notify",
      "type": "notify",
      "bpmn_element": "Send run report",
      "config": {
        "event": "triage_ready",
        "message": "${backlog.message}",
        "payload": {
          "new": "${backlog.new}",
          "backlog": "${backlog.backlog}",
          "invalid": "${backlog.invalid}",
          "awaiting": "${backlog.awaiting}"
        }
      }
    },
    {
      "id": "report_cfg",
      "type": "code",
      "bpmn_element": "Send run report",
      "config": {
        "function": "report.settings",
        "args": {
          "kind": "triage",
          "notify": "${backlog.notify}",
          "new_rows": "${rows.rows}",
          "backlog": "${backlog}"
        }
      }
    },
    {
      "id": "run_report",
      "type": "subflow",
      "bpmn_element": "Send run report",
      "config": {
        "flow": "run_report",
        "item": "${report_cfg.item}"
      }
    }
  ],
  "edges": [
    {
      "from": "cycle",
      "to": "migrate"
    },
    {
      "from": "migrate",
      "to": "list_inbox"
    },
    {
      "from": "list_inbox",
      "to": "read_triage"
    },
    {
      "from": "read_triage",
      "to": "read_list",
      "when": {
        "path": "config.layout.inbox_list_file",
        "truthy": true
      }
    },
    {
      "from": "read_triage",
      "to": "select_new",
      "default": true
    },
    {
      "from": "read_list",
      "to": "parse_list"
    },
    {
      "from": "parse_list",
      "to": "select_new"
    },
    {
      "from": "select_new",
      "to": "categorize"
    },
    {
      "from": "categorize",
      "to": "rows"
    },
    {
      "from": "rows",
      "to": "write_triage",
      "when": {
        "path": "rows.count",
        "gt": 0
      }
    },
    {
      "from": "rows",
      "to": "img_handoff",
      "default": true
    },
    {
      "from": "write_triage",
      "to": "img_handoff"
    },
    {
      "from": "img_handoff",
      "to": "images",
      "when": {
        "path": "img_handoff.count",
        "gt": 0
      }
    },
    {
      "from": "img_handoff",
      "to": "backlog",
      "default": true
    },
    {
      "from": "images",
      "to": "write_image_rows",
      "when": {
        "path": "images.outputs.finish.count",
        "gt": 0
      }
    },
    {
      "from": "images",
      "to": "backlog",
      "default": true
    },
    {
      "from": "write_image_rows",
      "to": "backlog"
    },
    {
      "from": "backlog",
      "to": "report_cfg"
    },
    {
      "from": "report_cfg",
      "to": "notify",
      "when": {
        "path": "report_cfg.legacy_notify",
        "truthy": true
      }
    },
    {
      "from": "report_cfg",
      "to": "run_report",
      "when": {
        "path": "report_cfg.enabled",
        "truthy": true
      }
    },
    {
      "from": "report_cfg",
      "to": "END",
      "default": true
    },
    {
      "from": "run_report",
      "to": "END",
      "on": "error"
    }
  ]
}
