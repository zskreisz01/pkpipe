{
  "id": "triage",
  "description": "20:00: read new INBOX items (one note per item, or the entries of the INBOX list file when the layout names one), suggest a category per item in an isolated session without tools (images are the owner's call), write the triage file and notify the owner.",
  "bpmn": "process-inbox-items",
  "start": "list_inbox",
  "max_parallel": 2,
  "nodes": [
    {
      "id": "list_inbox",
      "type": "tool",
      "bpmn_element": "Read new INBOX items",
      "config": {
        "tool": "obsidian:list_folder",
        "arguments": {
          "path": "${config.layout.inbox_dir}"
        }
      }
    },
    {
      "id": "read_triage",
      "type": "tool",
      "bpmn_element": "Read new INBOX items",
      "config": {
        "tool": "obsidian:read_triage"
      }
    },
    {
      "id": "read_list",
      "type": "tool",
      "bpmn_element": "Parse INBOX list",
      "config": {
        "tool": "obsidian:read_note",
        "arguments": {
          "path": "${config.layout.inbox_list_file}"
        }
      }
    },
    {
      "id": "parse_list",
      "type": "code",
      "bpmn_element": "Parse INBOX list",
      "config": {
        "function": "inbox.parse_list",
        "args": {
          "note": "${read_list}"
        }
      }
    },
    {
      "id": "select_new",
      "type": "code",
      "bpmn_element": "Read new INBOX items",
      "config": {
        "function": "inbox.select_new",
        "args": {
          "listing": "${list_inbox}",
          "triage": "${read_triage}",
          "folder": "${config.layout.inbox_dir}"
        }
      }
    },
    {
      "id": "categorize",
      "type": "subflow",
      "bpmn_element": "Categorize each item",
      "for_each": "select_new.items",
      "on_item_error": "continue",
      "config": {
        "flow": "categorize_item"
      }
    },
    {
      "id": "rows",
      "type": "code",
      "bpmn_element": "Categorize each item",
      "config": {
        "function": "triage.suggested_rows",
        "args": {
          "results": "${categorize}",
          "owner_items": "${select_new.owner_items}"
        }
      }
    },
    {
      "id": "write_triage",
      "type": "tool",
      "bpmn_element": "Categorize each item",
      "config": {
        "tool": "obsidian:update_triage",
        "arguments": {
          "rows": "${rows.rows}"
        }
      }
    },
    {
      "id": "backlog",
      "type": "code",
      "bpmn_element": "Notify: triage ready",
      "config": {
        "function": "triage.backlog",
        "args": {
          "triage": "${read_triage}",
          "new_rows": "${rows.rows}"
        }
      }
    },
    {
      "id": "notify",
      "type": "notify",
      "bpmn_element": "Notify: triage ready",
      "config": {
        "event": "triage_ready",
        "message": "${backlog.message}",
        "payload": {
          "new": "${backlog.new}",
          "backlog": "${backlog.backlog}",
          "invalid": "${backlog.invalid}",
          "awaiting": "${backlog.awaiting}"
        }
      }
    }
  ],
  "edges": [
    {
      "from": "list_inbox",
      "to": "read_triage"
    },
    {
      "from": "read_triage",
      "to": "read_list",
      "when": {
        "path": "config.layout.inbox_list_file",
        "truthy": true
      }
    },
    {
      "from": "read_triage",
      "to": "select_new",
      "default": true
    },
    {
      "from": "read_list",
      "to": "parse_list"
    },
    {
      "from": "parse_list",
      "to": "select_new"
    },
    {
      "from": "select_new",
      "to": "categorize"
    },
    {
      "from": "categorize",
      "to": "rows"
    },
    {
      "from": "rows",
      "to": "write_triage",
      "when": {
        "path": "rows.count",
        "gt": 0
      }
    },
    {
      "from": "rows",
      "to": "backlog",
      "default": true
    },
    {
      "from": "write_triage",
      "to": "backlog"
    },
    {
      "from": "backlog",
      "to": "notify",
      "when": {
        "path": "backlog.notify",
        "truthy": true
      }
    },
    {
      "from": "backlog",
      "to": "END",
      "default": true
    }
  ]
}
